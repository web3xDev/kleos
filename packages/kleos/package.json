{
  "name": "kleos-sdk",
  "version": "0.2.0",
  "description": "A portable track record for AI agents. Pair a runtime to an ERC-8004 agent and stamp every paid action on Monad.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3xDev/kleos.git",
    "directory": "packages/kleos"
  },
  "homepage": "https://kleos.finance",
  "keywords": [
    "ai-agents",
    "erc-8004",
    "x402",
    "monad",
    "reputation",
    "passkeys"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "bin": {
    "kleos": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "default": "./dist/receipt.js"
    },
    "./privy-auth": {
      "types": "./dist/privy-auth.d.ts",
      "default": "./dist/privy-auth.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@x402/core": "^2.26.0",
    "@x402/evm": "^2.26.0",
    "@x402/fetch": "^2.26.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
